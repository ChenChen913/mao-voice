{
  "hotkey": "alt_r",
  "refine_cycle_hotkey": "f9",
  "settings_hotkey": "f8",
  "asr": {
    "engine": "whisper",
    "model": "models/faster-whisper-medium",
    "language": null,
    "cloud_fallback": true,
    "cloud": {
      "base_url": "",
      "api_key": "",
      "model": "whisper-1"
    }
  },
  "recorder": {
    "auto_stop_silence_sec": 0,
    "device": "",
    "max_duration_sec": 300,
    "warmup_drafts": 1
  },
  "history": {
    "enabled": false,
    "max_entries": 100
  },
  "learn": {
    "enabled": false,
    "min_count": 2,
    "max_rules": 200
  },
  "refine": {
    "enabled": true,
    "base_url": "https://api.deepseek.com/v1",
    "api_key": "",
    "model": "deepseek-chat",
    "level": "conservative",
    "timeout_sec": 30
  },
  "ui": {
    "preview_sec": 1.5,
    "max_chars": 300
  },
  "inject": {
    "restore_delay_sec": 0.2,
    "require_same_focus": true,
    "paste_mode": "auto",
    "terminal_classes": [
      "ConsoleWindowClass",
      "CASCADIA_HOSTING_WINDOW_CLASS",
      "mintty",
      "PuTTY"
    ]
  }
}
